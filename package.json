{
  "private": true,
  "name": "ajuanijustus",
  "homepage": "https://www.ajuanijustus.com",
  "version": "2.0.0",
  "scripts": {
    "build": "node scripts/data/recipes.js && react-scripts build && node scripts/postbuild.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build",
    "eject": "react-scripts eject",
    "start": "node scripts/data/recipes.js && react-scripts start",
    "test": "react-scripts test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "react": "^18.3.1",
    "react-awesome-reveal": "^4.3.1",
    "react-bootstrap": "^2.10.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "prettier": "^3.2.5",
    "react-scripts": "^5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  }
}
